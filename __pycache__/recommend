CATEGORY_LABEL = {"coffee": "커피", "non_coffee": "논커피", "tea": "차", "ade_soda": "에이드 탄산음료"}


def search_menu(menu: List[Dict], query: str) -> List[Dict]:
    q = (query or "").strip().lower().replace(" ", "")
    if not q:
        return list(menu)
    out = []
    for item in menu:
        hay = (item["name"] + CATEGORY_LABEL.get(item["category"], "")).lower().replace(" ", "")
        if q in hay:
            out.append(item)
    return out

from typing import Any, Dict, List, Optional

PRICE_RANGES = {
    "under_3000": (0, 3000),
    "3000_4500": (3000, 4500),
    "4500_6000": (4500, 6000),
    "over_6000": (6000, 10**9),
}
CAFFEINE_RANK = {"none": 0, "low": 1, "high": 2}

# 기분 → 선호 카페인/카테고리 보정
FEELING_CAFFEINE_HINT = {"tired": "high", "calm": "low"}

# (질문 키: 가중치)  — 값이 클수록 점수에 많이 반영
WEIGHTS = {
    "category": 3.0, "flavor": 2.0, "sweetness": 2.0, "temperature": 2.0,
    "activity": 1.5, "feeling": 1.5, "caffeine": 3.0,
    "price": 3.0, "size": 1.5,
}
STRICT = {"category", "temperature", "caffeine", "price", "size"}


def _as_list(v: Any) -> List[Any]:
    if v is None or v == "" or v == []:
        return []
    return list(v) if isinstance(v, (list, tuple, set)) else [v]


def _is_answered(key: str, v: Any) -> bool:
    vals = _as_list(v)
    if not vals:
        return False
    # '상관없음/둘 다 괜찮음' 은 제약 없음 → 건너뜀
    if key in ("temperature", "caffeine", "size") and vals == ["any"]:
        return False
    return True


def _price_in_range(price: int, code: str) -> float:
    lo, hi = PRICE_RANGES[code]
    if lo <= price <= hi:
        return 1.0
    gap = (lo - price) if price < lo else (price - hi)
    return max(0.0, 1.0 - gap / 3000)  # 범위 밖이면 거리만큼 감점


def _score_one(key: str, v: Any, item: Dict) -> float:
    """0.0 ~ 1.0"""
    vals = _as_list(v)
    if key == "category":
        return 1.0 if item["category"] in vals else 0.0
    if key == "flavor":
        return len(set(vals) & set(item["flavors"])) / len(set(vals))
    if key == "sweetness":
        return max(0.0, 1.0 - abs(int(vals[0]) - item["sweetness"]) / 3)
    if key == "temperature":
        return 1.0 if vals[0] in item["temps"] else 0.0
    if key == "activity":
        return 1.0 if vals[0] in item["activities"] else 0.0
    if key == "feeling":
        s = 1.0 if vals[0] in item["feelings"] else 0.0
        hint = FEELING_CAFFEINE_HINT.get(vals[0])
        if hint and item["caffeine"] == hint:
            s = min(1.0, s + 0.3)
        return s
    if key == "caffeine":
        want = vals[0]
        if want == "none":
            return 1.0 if item["caffeine"] == "none" else 0.0
        if want == "high":
            return {"high": 1.0, "low": 0.4, "none": 0.0}[item["caffeine"]]
        if want == "low":
            return {"low": 1.0, "high": 0.5, "none": 0.3}[item["caffeine"]]
    if key == "price":
        return _price_in_range(item["price"], vals[0])
    if key == "size":
        return 1.0 if vals[0] in item["sizes"] else 0.0
    return 0.0


def _flatten(answers: Dict[str, Optional[Dict[str, Any]]]) -> Dict[str, Any]:
    flat: Dict[str, Any] = {}
    for section in ("taste", "mood", "budget"):
        for k, v in (answers.get(section) or {}).items():
            if k in WEIGHTS and _is_answered(k, v):
                flat[k] = v
    return flat


def recommend(menu: List[Dict], answers: Dict[str, Optional[Dict[str, Any]]], top_n: int = 5) -> Dict[str, Any]:
    """answers 예시 (모든 섹션/문항 선택사항):
        {"taste": {"category": ["coffee"], "sweetness": 1},
         "mood":  {"caffeine": "none"},
         "budget": {"price": "3000_4500"}}
    """
    prefs = _flatten(answers or {})

    # 응답이 없으면 인기순
    if not prefs:
        ranked = sorted(menu, key=lambda m: -m.get("popularity", 0))[:top_n]
        return {"answered": [], "mode": "popular",
                "results": [{"item": m, "score": None, "reasons": ["인기 메뉴"], "relaxed": False, "unmet": []}
                            for m in ranked]}

    max_total = sum(WEIGHTS[k] for k in prefs)
    rows = []
    for item in menu:
        total, reasons, unmet = 0.0, [], []
        for k, v in prefs.items():
            s = _score_one(k, v, item)
            total += WEIGHTS[k] * s
            if s >= 0.99:
                reasons.append(k)
            elif k in STRICT and s < 0.5:
                unmet.append(k)
        rows.append({"item": item,
                     "score": round(total / max_total * 100, 1),
                     "reasons": reasons, "unmet": unmet, "relaxed": bool(unmet)})

    tiebreak = lambda r: (-r["score"], -r["item"].get("popularity", 0))
    strict_ok = sorted([r for r in rows if not r["unmet"]], key=tiebreak)
    relaxed = sorted([r for r in rows if r["unmet"]], key=tiebreak)
    results = (strict_ok + relaxed)[:top_n]
    for r in results:
        r["reasons"] = [REASON_TEXT[k] for k in r["reasons"]]
        r["unmet"] = [REASON_TEXT[k] for k in r["unmet"]]
    return {"answered": sorted(prefs.keys()), "mode": "personalized", "results": results}


REASON_TEXT = {
    "category": "원하는 음료 종류", "flavor": "선호하는 맛", "sweetness": "원하는 단맛 정도",
    "temperature": "원하는 온도", "activity": "지금 하는 일에 어울림", "feeling": "현재 기분에 어울림",
    "caffeine": "카페인 조건", "price": "예산 범위", "size": "원하는 사이즈",
}


