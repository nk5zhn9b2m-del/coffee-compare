import streamlit as st

TITLES = {"taste": "1. 취향 바탕", "mood": "2. 기분 바탕", "budget": "3. 구매 조건 바탕"}
SZ = {"small": "작은", "medium": "보통", "large": "큰"}
CAF = {"none": "없음", "low": "약간", "high": "많음"}
TOTAL_Q = sum(len(s["questions"]) for s in SURVEY.values())


def show_item(r_or_item, extra=""):
    m = r_or_item
    temps = "/".join("차가움" if t == "ice" else "따뜻함" for t in m["temps"])
    sizes = "/".join(SZ[s] for s in m["sizes"])
    st.markdown(f"**{m['name']}** {extra}")
    st.caption(f"{CATEGORY_LABEL[m['category']]} · {m['price']:,}원 · {temps} · 카페인 {CAF[m['caffeine']]} · {sizes} 사이즈")


st.set_page_config(page_title="음료 검색 · 추천", page_icon="☕")
st.title("☕ 음료 검색 · 추천")
tab_search, tab_rec = st.tabs(["🔍 검색", "✨ 추천"])

with tab_search:
    q = st.text_input("메뉴 이름이나 종류 (예: 라떼, 에이드, 차)", key="search_q")
    found = search_menu(MENU, q)
    if not found:
        st.info("검색 결과가 없어요.")
    for m in found:
        show_item(m)
        st.divider()

with tab_rec:
    st.caption(f"총 {TOTAL_Q}개 질문이에요. 전부 답하지 않아도, 원하는 것만 골라 추천받을 수 있어요.")
    answers = {}
    for sec_key, sec in SURVEY.items():
        st.subheader(TITLES[sec_key])
        answers[sec_key] = {}
        for i, qd in enumerate(sec["questions"], 1):
            labels = [o[1] for o in qd["options"]]
            by_label = {o[1]: o[0] for o in qd["options"]}
            key = f"ans_{qd['id']}"
            title = f"Q{i}. {qd['text']}"
            if qd["multi"]:
                picked = st.multiselect(title + " (복수 선택 가능)", labels, key=key, placeholder="선택 안 해도 돼요")
                if picked:
                    answers[sec_key][qd["id"]] = [by_label[p] for p in picked]
            else:
                picked = st.radio(title, labels, index=None, key=key, horizontal=True)
                if picked is not None:
                    answers[sec_key][qd["id"]] = by_label[picked]
        st.divider()

    n_done = sum(len(v) for v in answers.values())
    st.write(f"**{TOTAL_Q}문항 중 {n_done}문항 선택됨**")

    def reset():
        for sec in SURVEY.values():
            for qd in sec["questions"]:
                st.session_state.pop(f"ans_{qd['id']}", None)
    c1, c2 = st.columns(2)
    go = c1.button("추천받기", type="primary", use_container_width=True)
    c2.button("초기화", on_click=reset, use_container_width=True)

    if go:
        res = recommend(MENU, answers, top_n=5)
        if res["mode"] == "popular":
            st.info("선택한 항목이 없어서 인기 메뉴를 보여드려요.")
        for r in res["results"]:
            score = "" if r["score"] is None else f"— {r['score']}점"
            show_item(r["item"], score)
            if r["reasons"]:
                st.success("✔ " + ", ".join(r["reasons"]))
            if r["unmet"]:
                st.warning("※ 맞지 않는 조건: " + ", ".join(r["unmet"]))
            st.divider()
